              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "GET פוסטים של משתמש",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/1/posts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }

BASE_URL=https://your-api-url.com
TIMEOUT=10

# Performance thresholds (seconds)
PERF_MAX_RESPONSE_TIME=2.0
PERF_ACCEPTABLE_RESPONSE_TIME=1.0
PERF_MAX_STD_DEV=0.5

# Email reporting — set to "true" to send report after each run
SEND_EMAIL_REPORT=false
EMAIL_SENDER=your-email@gmail.com
EMAIL_RECEIVER=recipient@gmail.com
EMAIL_PASSWORD=your-app-password-here

# AWS
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# CloudWatch — מדדי בדיקות (שלב 30)
CLOUDWATCH_NAMESPACE=API-Testing
ENVIRONMENT=local

# EC2 — הרצת בדיקות בענן (שלב 29)
# AMI_ID לפי region — בדוק ב-AWS Console
EC2_AMI_ID=ami-0c02fb55956c7d316
EC2_INSTANCE_TYPE=t2.micro
EC2_IAM_INSTANCE_PROFILE=api-test-runner-role
EC2_KEY_NAME=
EC2_SUBNET_ID=
EC2_SECURITY_GROUP_ID=
